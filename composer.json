{
    "name": "omnischolar/inspire",
    "type": "library",
    "description": "Omnischolar INSPIRE-HEP: high-energy physics authors (BAI, ORCID), their positions and citation summary, their literature with citation counts - no key.",
    "keywords": [
        "scholarly",
        "publications",
        "inspire",
        "hep",
        "physics",
        "citations",
        "omnischolar"
    ],
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "glitchr/omnischolar": "^1.0@dev",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Omnischolar\\Inspire\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnischolar\\Inspire\\Tests\\": "Tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
